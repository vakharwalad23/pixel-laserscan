{
  "name": "laserscan",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.23",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:core": "cd modules/laser-core/cpp-tests && g++ -std=c++17 -O2 -fsanitize=address,undefined -I../android/src/main/cpp ../android/src/main/cpp/fusion.cpp test_fusion.cpp -o t && ./t",
    "build:apk": "expo prebuild -p android && cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a"
  },
  "private": true
}
